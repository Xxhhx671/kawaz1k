    if selectedParts[_dznhw("MB4KDAQJHQ==")] then table.insert(candidateParts, {name = _dznhw("MB4KDAQJHQ=="), part = char:FindFirstChild(_dznhw("LwUSBBc+GhkGBg==")) or char:FindFirstChild(_dznhw("Kx8IAAsFHA8nBhkSMwsXFQ=="))}) end
    if selectedParts[_dznhw("IhgIEg==")] then 
        table.insert(candidateParts, {name = _dznhw("IhgIEg=="), part = char:FindFirstChild(_dznhw("Lw8DFS0LGw8=")) or char:FindFirstChild(_dznhw("Lw8DFSQYGA=="))})
